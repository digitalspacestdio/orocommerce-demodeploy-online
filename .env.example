# Copy to .env and adjust. Every value also has a default in docker/compose/*.yml,
# so an empty .env already produces a working demo site.
#
# This file is read twice: for ${VAR} substitution in the compose files and as `env_file`
# of the Oro containers. The env_file parser keeps everything after `=`, so never put an
# inline comment after a value — comments live on their own line.

# --- Application -------------------------------------------------------------
# ORO_ENV: prod | dev (dev is much slower)
ORO_ENV=prod
# HTTP_PORT: host port of the demo site (local stack only)
HTTP_PORT=8092
ORO_APP_URL=http://localhost:8092
# ORO_PUBLIC_HOST: host[:port] part of ORO_APP_URL
ORO_PUBLIC_HOST=localhost:8092
# ORO_PUBLIC_HTTPS: on when ORO_APP_URL is https
ORO_PUBLIC_HTTPS=off
ORO_SECRET=ThisTokenIsNotSoSecretChangeIt

# --- Admin user created by oro:install ---------------------------------------
ORO_USER_NAME=admin
ORO_USER_PASSWORD=Admin1234!
ORO_USER_EMAIL=admin@example.com
ORO_USER_FIRSTNAME=Admin
ORO_USER_LASTNAME=User
ORO_ORGANIZATION_NAME=OroCommerce Demo
ORO_LANGUAGE=en
ORO_FORMATTING_CODE=en_US

# --- Demo data ---------------------------------------------------------------
# ORO_SAMPLE_DATA: y | n - demo catalogue, customers, orders
ORO_SAMPLE_DATA=y
# ORO_INSTALL_MODE: auto | install | restore
# auto restores docker/orocommerce/dumps/<ORO_DUMP_NAME> when present, otherwise runs oro:install.
# Use restore together with ORO_DUMP_URL for fast deploys of a prepared demo snapshot.
ORO_INSTALL_MODE=auto
ORO_DUMP_NAME=demo
# ORO_DUMP_URL: optional remote <name>.tar.gz downloaded into /dumps; leave empty to install
ORO_DUMP_URL=

# --- Infrastructure ----------------------------------------------------------
ORO_DB_NAME=oro_db
ORO_DB_USER=oro_db_user
ORO_DB_PASSWORD=oro_db_pass
# ORO_DB_PORT is published on 127.0.0.1 in the local stack only
ORO_DB_PORT=5433
MAIL_UI_PORT=8026
HOST_UID=1000
HOST_GID=1000
# Production mail, e.g. smtp://user:pass@smtp.example.com:587
# ORO_MAILER_DSN=

# --- Production only (docker-compose.prod.yml / docker-compose.dokploy.yml) ---
# ORO_APP_URL=https://demo.example.com
# ORO_PUBLIC_HOST=demo.example.com
# ORO_PUBLIC_HTTPS=on
# TRAEFIK_DOCKER_NETWORK: dokploy-network for Dokploy, orodemo-edge for docker-compose.prod.yml
TRAEFIK_HOST_RULE=Host(`demo.example.com`)
TRAEFIK_DOCKER_NETWORK=dokploy-network
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# ACME_EMAIL is used by the embedded Traefik only
ACME_EMAIL=ops@example.com
# Prebuilt image names (optional)
# ORO_IMAGE=orocommerce-demo:7.0.4
# ORO_NGINX_IMAGE=orocommerce-demo-nginx:7.0.4
